# Pick ONE: ollama | gemini | openrouter
LLM_PROVIDER=ollama

# --- Ollama (local, free). Run: ollama pull llama3.2 ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# --- Gemini free API. Key: https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter. Key: https://openrouter.ai/keys (use ":free" models) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- RAG knobs (students play with these) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
